datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Service {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  shortDesc        String
  fullDesc         String
  icon             String
  image            String
  gallery          String?  // Stored as JSON string array of image URLs
  brochureUrl      String?  // PDF Brochure / Datasheet link
  specs            String   // Stored as JSON string (specs list)
  standards        String   // Stored as JSON string (standards list)
  faq              String   // Stored as JSON string (Q&As list)
  industriesServed String?  // Stored as JSON string array or comma-separated
  serviceLocations String?  // e.g. "Mumbai, Maharashtra & Pan-India"
  relatedServices  String?  // Stored as JSON string array
  metaTitle        String?
  metaDesc         String?
  keywords         String?  // Comma-separated or JSON
  canonicalUrl     String?  // Custom Canonical URL
  robotsMeta       String?  @default("index, follow") // "index, follow" | "noindex, nofollow"
  publisher        String?  @default("Thermopharm Engineering")
  author           String?  @default("Thermopharm HVAC Engineering Team")
  status           String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Industry {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  icon        String   @default("Factory")
  shortDesc   String
  fullDesc    String
  image       String
  specs       String   // Stored as JSON string
  standards   String   // Stored as JSON string
  metaTitle   String?
  metaDesc    String?
  status      String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id                  String   @id @default(uuid())
  slug                String   @unique
  title               String
  location            String
  year                String
  client              String
  category            String
  image               String
  imageAlt            String?  // Alt text for primary feature image
  gallery             String?  // Stored as JSON array of images/objects
  videoUrl            String?  // YouTube/Vimeo walkthrough link
  description         String
  challenge           String
  solution            String
  results             String   // Stored as JSON string (results list)
  tags                String   // Stored as JSON string (tags list)
  faq                 String   // Stored as JSON string (Q&As list)
  facilitySize        String?  // e.g. "45,000 sq. ft."
  industrySector      String?  // e.g. "Oral Solid Dosage (OSD)", "Biotech"
  complianceStandards String?  // Stored as JSON string
  technologiesUsed    String?  // Stored as JSON string
  testimonialQuote    String?  // Client feedback quote
  testimonialAuthor   String?  // Client name & title
  relatedServices     String?  // Stored as JSON string array
  metaTitle           String?
  metaDesc            String?
  keywords            String?
  ogImage             String?  // Open Graph preview image
  canonicalUrl        String?  // Custom Canonical URL override
  robotsMeta          String?  @default("index, follow")
  publisher           String?  @default("Thermopharm Engineering")
  author              String?  @default("Thermopharm HVAC Engineering Team")
  status              String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BlogPost {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  image     String
  category  String
  author    String
  date      String
  readTime  String
  faq       String   // Stored as JSON string (Q&As list)
  metaTitle String?
  metaDesc  String?
  status    String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  company   String?
  content   String
  avatar    String?
  rating    Int      @default(5)
  status    String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  company   String
  email     String
  phone     String
  service   String
  message   String
  status    String   @default("NEW") // "NEW" | "READ" | "CONTACTED" | "ARCHIVED"
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                        String   @id @default("default")
  gaId                      String?  // Google Analytics GA4 ID (e.g. G-XXXXXXXXXX)
  gtmId                     String?  // Google Tag Manager ID (e.g. GTM-XXXXXXX)
  searchConsoleVerification String?  // Google Search Console verification HTML code or token
  clarityId                 String?  // Microsoft Clarity / Analytics ID
  customHeadScripts         String?  // Custom script tags injected inside <head>
  customBodyScripts         String?  // Custom script tags injected inside <body>
  seoDefaultTitle           String?  // Global SEO Default Title
  seoDefaultDesc            String?  // Global SEO Default Description
  updatedAt                 DateTime @updatedAt
}
